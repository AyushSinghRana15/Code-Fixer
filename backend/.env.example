# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# LLM providers: the agent uses every provider that has a key, in FIXER_PROVIDERS order.
FIXER_OPENROUTER_API_KEY=
# FIXER_NVIDIA_API_KEY=
# FIXER_GROQ_API_KEY=
# FIXER_GEMINI_API_KEY=
# FIXER_MISTRAL_API_KEY=

# Fallback order (comma-separated). Only providers with a key are used.
FIXER_PROVIDERS=openrouter,nvidia,groq,gemini,mistral

# Optional: override the model used for fixing on OpenRouter (must support tool calling).
# FIXER_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Sandbox: "local" (temp copy on this machine, no isolation) or "docker".
FIXER_SANDBOX=local
